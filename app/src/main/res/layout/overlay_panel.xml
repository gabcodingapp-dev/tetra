<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="top|start">

    <TextView
        android:id="@+id/bubble"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_margin="6dp"
        android:background="@drawable/ic_bubble_oval"
        android:gravity="center"
        android:text="T"
        android:textColor="#1B1B26"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:background="@drawable/panel_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TETRA"
                android:textColor="@color/tetra_accent"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/close_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/chip_bg"
                android:text="✕"
                android:textColor="@color/tetra_text_dim"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minLines="2"
            android:text="Starting…"
            android:textColor="@color/tetra_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/stats_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Max tile: — · Moves: 0"
            android:textColor="@color/tetra_text_dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/play_btn"
                style="@style/TetraChip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="⏸ Pause" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/speed_btn"
                style="@style/TetraChip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ 0.5s" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/strategy_btn"
                style="@style/TetraChip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Expectimax" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/calibrate_btn"
                style="@style/TetraChip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⌖ Align" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Open your 2048 app, then bubble → Align to frame the board. Resume after game over."
            android:textColor="@color/tetra_text_dim"
            android:textSize="11sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/quit_btn"
            style="@style/TetraChip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="✕ Stop Tetra"
            android:backgroundTint="@color/tetra_bad" />
    </LinearLayout>
</LinearLayout>